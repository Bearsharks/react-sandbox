{
  "name": "mfp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/myfront",
    "packages/mylib",
    "packages/yourfront"
  ],
  "scripts": {
    "dev": "yarn workspace myfront dev",
    "dev:myfront": "yarn workspace myfront dev",
    "dev:yourfront": "yarn workspace yourfront dev",
    "dev:both": "concurrently \"yarn workspace myfront dev\" \"yarn workspace yourfront dev\"",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "test": "vitest"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.2.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.1"
  }
}
